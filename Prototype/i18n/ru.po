msgstr "Эксперт"

msgid "settings.difficulty_help"
msgstr "Новичок: после выстрела ракета следует за движениями самолёта. Эксперт: она летит прямо, и её уже нельзя скорректировать."

msgid "help.title"
msgstr "Помощь"

msgid "help.tab_mission"
msgstr "Задание"

